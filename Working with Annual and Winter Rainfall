```{r}
# Calculating Annual Winter Averages:
# Winter rainfall data will be defined as October of the previous year to April of the following year to look into 
# the moisture period that could influence stinknet germination, establishment, and growth
# Winter/growing-season rainfall year = October of the previous year through April of the focal year
# Winter 2005 = October 2004–April 2005
# Ommitting year 2000
```

```{r}
# Workflow: 
# Step 1. Calculate winter rainfall value for each site and each year
# Step 2. Average winter values across the same 5 sample windows for sites

# Step 1a: add month and year
rain_winter_prep <- rain_long_used_cm %>%
  mutate(
    month = month(Date),
    year = year(Date)
  )

# Step 1b: keep only October-April
rain_winter_months <- rain_winter_prep %>%
  filter(month %in% c(10, 11, 12, 1, 2, 3, 4))

# Step 1c: assign winter year
rain_winter_months <- rain_winter_months %>%
  mutate(
    winter_year = ifelse(month %in% c(10, 11, 12), year + 1, year)
  )

# Step 1d: Remove year 2000
rain_winter_months <- rain_winter_months %>%
  filter(winter_year >= 2001)

# Step 1e: sum winter rainfall by station and winter year
winter_rain_by_station <- rain_winter_months %>%
  group_by(station_id, winter_year) %>%
  summarise(
    winter_rainfall_cm = sum(rainfall_cm, na.rm = TRUE),
    .groups = "drop"
  )

```

```{r}
# Step 2. Calculate winter rainfall by site
winter_rain_by_site <- site_station_long %>%
  left_join(
    winter_rain_by_station,
    by = "station_id",
    relationship = "many-to-many"
  ) %>%
  group_by(site_code, winter_year) %>%
  summarise(
    site_winter_rainfall_cm = mean(winter_rainfall_cm, na.rm = TRUE),
    n_stations_used = n(),
    .groups = "drop"
  ) 

# Check individual site
winter_rain_by_site %>%
  filter(site_code == "AA09")
```



# Workflow for working with rainfall data:
# Create annual rainfall totals for each station across years
# Assign totals to sites and average for 5 year windows for each sampling site
## Step 1 adds up daily rainfall to get annual rainfall totals for each station
## Step 2 use look-up table so each site–station pair is easy to match annual rainfall totals
## Step 3 calculate annual rainfall for each site, averaging the two stations when available
## The value is the site’s annual rainfall estimate for that year


```{r}
# Create annual rainfall totals for each station

station_year_rain <- rain_long_cm %>%
  mutate(year = year(Date)) %>%
  group_by(station_id, year) %>%
  summarise(
    annual_rainfall_cm = sum(rainfall_cm, na.rm = TRUE),
    .groups = "drop"
  ) 
```

```{r}
site_year_rain <- site_station_long %>%
  left_join(station_year_rain, by = "station_id", relationship = "many-to-many") %>%
  group_by(site_code, year) %>%
  summarise(
    site_annual_rainfall_cm = mean(annual_rainfall_cm, na.rm = TRUE),
    n_stations_used = n(),
    .groups = "drop"
  )
```

```{r}
# Save Summary Table
write.csv(site_year_rain, "site_year_rain.csv", row.names = FALSE) 
```


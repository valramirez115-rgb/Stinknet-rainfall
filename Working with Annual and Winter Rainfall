write.csv(low_rain_present, "low_rain_present.csv", row.names = FALSE)
write.csv(low_rain_absent, "low_rain_absent.csv", row.names = FALSE)
write.csv(candidate_sites_combined, "candidate_sites_combined.csv", row.names = FALSE)

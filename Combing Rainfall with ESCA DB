# Combine rainfall data with ESCA database

# Start with buidling database (ESCA_2023) without sampling year 2000

ESCA_sampling_data <- ESCA_2023 %>%
  mutate(sample_year = year(sample_date)) %>%
  filter(sample_year != 2000) %>%
  select(
    site_code,
    sample_date,
    sample_year,
    ONCPIL,
    elevation,
    broad_classes,
    detailed_classes,
    specific_classes,
    lu1912,
    lu1912Broad,
    clay,
    sand,
    silt,
    ammonT,
    ammonB,
    nitrT,
    nitrB,
    phosT,
    phosB,
    ocarbT,
    ocarbB,
    somT,
    somB,
    pH,
    conduct,
    swcT,
    swcB,
    TnitT,
    BnitT,
    bulkdens,
    cnT,
    cnB,
    species_richness
  )
```

```{r}
# Merge
ESCA_rain_merged <- ESCA_sampling_data %>%
  left_join(
    annual_winter_compare,
    by = c("site_code", "sample_year")
  )

ESCA_rain_merged <- ESCA_rain_merged %>%
  relocate(
    site_sample_window_avg_rainfall_cm,
    site_winter_window_rainfall_cm,
    .after = ONCPIL
  )
```


```{r}
# Adding look-up table with ESCA site codes and FCDMC station IDs
# A separate site lookup table was created to link ESCA site codes with their associated FCDMC rain station IDs.
# The lookup table is standalone table for cross-referencing between the ESCA and rainfall datasets

site_station_lookup_raw <- read_excel("Site_LookUp_Table.xlsx")

#Inspect
names(site_station_lookup_raw)
head(site_station_lookup_raw)
str(site_station_lookup_raw)

#Change both to characters
site_station_lookup_raw <- site_station_lookup_raw %>%
  mutate(
    ESCA_site_code = as.character(ESCA_site_code),
    fcdmc_station_id = as.character(fcdmc_station_id)
  )

#Change format to one row per ESCA site code and rename to match ESCA database site_code column
## If site only has one FCDMC station, station 2 will be listed as NA

site_station_lookup <- site_station_lookup_raw %>%
  group_by(ESCA_site_code) %>%
  mutate(station_num = row_number()) %>%
  pivot_wider(
    names_from = station_num,
    values_from = fcdmc_station_id,
    names_prefix = "station"
  ) %>%
  distinct() %>%
  ungroup() %>%
  rename(site_code = ESCA_site_code)

#Check site codes that are in ESCA_2023 and site_station_lookup, should be 201
sum(site_station_lookup$site_code %in% ESCA_2023$site_code)

#Find any unmatched site codes to make sure site codes match in both datasets
site_station_lookup %>%
  filter(!site_code %in% ESCA_2023$site_code)


```

```{r}

# 4-site set:
# high rainfall and stinknet presence
# high rainfall and stinknet absent
# low rainfall and stinknet presence
# low rainfall and stinknet absence
# ranking the sites by their rainfall summary/values not statistical cutoffs

# 1. Build a site-level summary
# take mean of the site’s sample-window rainfall average
site_selection_summary <- ESCA_rain_merged %>%
  group_by(site_code) %>%
  summarise(
    mean_annual_rain = mean(site_sample_window_avg_rainfall_cm, na.rm = TRUE),
    mean_winter_rain = mean(site_winter_window_rainfall_cm, na.rm = TRUE),
    ever_present = max(ONCPIL, na.rm = TRUE),
    .groups = "drop"
  )

site_selection_summary %>%
  arrange(mean_annual_rain)


site_selection_summary %>%
  arrange(desc(mean_annual_rain))

# Creating candidate sites
high_rain_present <- site_selection_summary %>%
  filter(ever_present == 1) %>%
  arrange(desc(mean_annual_rain))

high_rain_absent <- site_selection_summary %>%
  filter(ever_present == 0) %>%
  arrange(desc(mean_annual_rain))

low_rain_present <- site_selection_summary %>%
  filter(ever_present == 1) %>%
  arrange(mean_annual_rain)

low_rain_absent <- site_selection_summary %>%
  filter(ever_present == 0) %>%
  arrange(mean_annual_rain)

candidate_sites_combined <- bind_rows(
  high_rain_present %>% mutate(candidate_group = "high_rain_present"),
  high_rain_absent  %>% mutate(candidate_group = "high_rain_absent"),
  low_rain_present  %>% mutate(candidate_group = "low_rain_present"),
  low_rain_absent   %>% mutate(candidate_group = "low_rain_absent")
)
ESCA_rain_merged %>%
  group_by(ONCPIL) %>%
  summarise(
    n = n(),
    mean_annual_rain = mean(site_sample_window_avg_rainfall_cm, na.rm = TRUE),
    median_annual_rain = median(site_sample_window_avg_rainfall_cm, na.rm = TRUE),
    sd_annual_rain = sd(site_sample_window_avg_rainfall_cm, na.rm = TRUE),
    .groups = "drop"
  )

#Save
write.csv(high_rain_present, "high_rain_present.csv", row.names = FALSE)
write.csv(high_rain_absent, "high_rain_absent.csv", row.names = FALSE)
write.csv(low_rain_present, "low_rain_present.csv", row.names = FALSE)
write.csv(low_rain_absent, "low_rain_absent.csv", row.names = FALSE)
write.csv(candidate_sites_combined, "candidate_sites_combined.csv", row.names = FALSE)

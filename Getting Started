# Calculating winter averages
# Winter 2005 = October 2004–April 2005
# Manually check averages
# Check number of NAs for certain years? 
#  Winter rainfall data will be defined as October-April of the following year to look into the moisture period that could influence stinknet germination, establishment, and growth
# Winter/growing-season rainfall year = October of the previous year through April of the focal year
# Ommitting year 2000
# Keep number of stations used?
```

```{r}
# Workflow: step 1. calculate a winter rainfall value for each site and year
# Step 2. average winter values across the same 5 windows windows for sites

# Step 1: add month and year
rain_winter_prep <- rain_long_used_cm %>%
  mutate(
    month = month(Date),
    year = year(Date)
  )

# Step 2: keep only October-April
rain_winter_months <- rain_winter_prep %>%
  filter(month %in% c(10, 11, 12, 1, 2, 3, 4))

# Step 3: assign winter year
rain_winter_months <- rain_winter_months %>%
  mutate(
    winter_year = ifelse(month %in% c(10, 11, 12), year + 1, year)
  )

# Step 4: Remove year 2000
rain_winter_months <- rain_winter_months %>%
  filter(winter_year >= 2001)

# Step 5: sum winter rainfall by station and winter year
winter_rain_by_station <- rain_winter_months %>%
  group_by(station_id, winter_year) %>%
  summarise(
    winter_rainfall_cm = sum(rainfall_cm, na.rm = TRUE),
    .groups = "drop"
  )

#Need to manually check sums
```

